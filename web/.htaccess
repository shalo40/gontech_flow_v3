# ============================================================
# Gontech Solutions — Flutter Web SPA / cPanel Production
# Arquitecto: Gontech DevOps Senior
# Versión: 1.0 — Junio 2026
# ============================================================
# PROPÓSITO: Redirigir TODAS las rutas internas de la SPA
# de Flutter Web a index.html para evitar errores 404 al
# recargar o navegar directamente a una URL profunda.
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Definir la base si el app está en una subcarpeta ─────────────
    # Si el app vive en la raíz del dominio, deja RewriteBase /
    # Si vive en /app, cámbialo a RewriteBase /app/
    RewriteBase /

    # ── No redirigir si el archivo físico existe ─────────────────────
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # ── No redirigir si la carpeta física existe ─────────────────────
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── Todo lo demás → index.html (Flutter Router toma el control) ──
    RewriteRule ^ index.html [L]

</IfModule>

# ── Cabeceras de Seguridad ────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Permitir SharedArrayBuffer (necesario para WASM de Flutter)
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
</IfModule>

# ── Caché agresiva para assets compilados de Flutter ─────────────────
# Flutter genera hashes únicos en los nombres de archivo, por lo que
# es seguro cachear assets estáticos por 1 año.
<IfModule mod_expires.c>
    ExpiresActive On

    # index.html NO se cachea (siempre fresco)
    <FilesMatch "^index\.html$">
        ExpiresDefault "access plus 0 seconds"
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
    </FilesMatch>

    # Flutter bootstrap y WASM
    ExpiresByType application/wasm          "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"

    # Assets de imágenes e iconos
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"

    # Fuentes
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType application/font-woff    "access plus 1 year"

    # CSS
    ExpiresByType text/css                 "access plus 1 year"

    # JSON (manifest, etc.)
    ExpiresByType application/json         "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>

# ── Compresión GZIP ───────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
</IfModule>

# ── Tipo MIME correcto para WebAssembly ───────────────────────────────
<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>
